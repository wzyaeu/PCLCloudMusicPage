        <TextBlock Margin="0,2,0,0"
                   FontSize="12"
                   Text="Michael Jackson"
                   Height="14"
                   ToolTip="Michael Jackson"/>
        <StackPanel Orientation="Horizontal"
                    Margin="0,2,0,0">
            <local:MyButton
                Margin="1,0,1,0"
                Height="18"
                Width="37"
                Text="查看"
                EventType="打开网页"
                EventData="https://music.163.com/#/song?id=21178386"/>
            <local:MyButton
                Visibility="Visible"
