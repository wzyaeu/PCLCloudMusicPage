                Height="18"
                Width="50"
                ToolTip="呼出本地网易云音乐打开！"
                Text="客户端"
                EventType="打开网页"
                EventData="https://p.kaphia.qzz.io/PCLCloudMusicPageRedirect?id=21178386&amp;type=song"/>
            <TextBlock Margin="1,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Text="Invincible"
                       ToolTip="Invincible"/>
        </StackPanel>
    </StackPanel>
    <StackPanel VerticalAlignment="Top"
