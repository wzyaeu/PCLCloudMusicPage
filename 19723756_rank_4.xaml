                   Text="78"/>
    </StackPanel>
</Border>
            <TextBlock Margin="0,5,0,0"
                       FontSize="17"
                       FontWeight="Bold"
                       Text="AM（2.0）"
                       ToolTip="AM（2.0）"/>
        </StackPanel>
        <TextBlock Margin="0,2,0,0"
                   FontSize="12"
                   Text="T-Chenxi/Puer/BallyCash"
                   Height="14"
                   ToolTip="T-Chenxi/Puer/BallyCash"/>
        <StackPanel Orientation="Horizontal"
                    Margin="0,2,0,0">
            <local:MyButton
                Margin="1,0,1,0"
                Height="18"
                Width="37"
                Text="查看"
                EventType="打开网页"
                EventData="https://music.163.com/#/song?id=3423069219"/>
            <local:MyButton
                Visibility="Visible"
                Margin="1,0,1,0"
                Height="18"
                Width="50"
                ToolTip="呼出本地网易云音乐打开！"
                Text="客户端"
                EventType="打开网页"
                EventData="https://p.kaphia.qzz.io/PCLCloudMusicPageRedirect?id=3423069219&amp;type=song"/>
            <TextBlock Margin="1,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Text="重制版"
                       ToolTip="重制版"/>
        </StackPanel>
    </StackPanel>
    <StackPanel VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="-7,-7,-7,0">
                
    </StackPanel>
</local:MyCard>
