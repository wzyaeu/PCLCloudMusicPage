                EventData="https://p.kaphia.qzz.io/PCLCloudMusicPageRedirect?id=3350289592&amp;type=song"/>
            <TextBlock Margin="1,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Text="Slowed: Vol. 1"
                       ToolTip="Slowed: Vol. 1"/>
        </StackPanel>
    </StackPanel>
    <StackPanel VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="-7,-7,-7,0">
                
    </StackPanel>
