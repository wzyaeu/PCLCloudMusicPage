                       FontWeight="Bold"
                       Text="Её парень: Slowed"
                       ToolTip="Её парень: Slowed"/>
        </StackPanel>
        <TextBlock Margin="0,2,0,0"
                   FontSize="12"
                   Text="Shluzov"
                   Height="14"
                   ToolTip="Shluzov"/>
        <StackPanel Orientation="Horizontal"
                    Margin="0,2,0,0">
            <local:MyButton
                Margin="1,0,1,0"
                Height="18"
                Width="37"
                Text="查看"
                EventType="打开网页"
                EventData="https://music.163.com/#/song?id=3350289592"/>
            <local:MyButton
                Visibility="Visible"
                Margin="1,0,1,0"
                Height="18"
                Width="50"
                ToolTip="呼出本地网易云音乐打开！"
                Text="客户端"
