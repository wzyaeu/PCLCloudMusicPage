    <StackPanel Margin="10">
        <Grid Height="143"
              Width="143">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <local:MyImage
                    Source="https://p4.music.126.net/Bz9g4t-ZaBLL2Gky2eyhxA==/109951166983050895.jpg"/>
            </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal">
            <Border VerticalAlignment="Center"
        Height="20"
        Width="45"
        Margin="0,5,5,-1"
        Background="#7b859a"
        CornerRadius="7">
    <StackPanel HorizontalAlignment="Center"
                Margin="3"
                VerticalAlignment="Center"
                Orientation="Horizontal">
        <TextBlock FontSize="10"
                   Foreground="{DynamicResource ColorBrush8}"
                   VerticalAlignment="Bottom"
                   Text="No."/>
        <TextBlock FontSize="15"
            Margin="0,0,0,-2"
                   Foreground="{DynamicResource ColorBrush8}"
                   VerticalAlignment="Bottom"
                   Text="18"/>
    </StackPanel>
</Border>
            <TextBlock Margin="0,5,0,0"
                       FontSize="17"
                       FontWeight="Bold"
                       Text="从前说"
                       ToolTip="从前说"/>
        </StackPanel>
        <TextBlock Margin="0,2,0,0"
                   FontSize="12"
                   Text="小阿七"
                   Height="14"
                   ToolTip="小阿七"/>
        <StackPanel Orientation="Horizontal"
                    Margin="0,2,0,0">
            <local:MyButton
                Margin="1,0,1,0"
                Height="18"
                Width="37"
                Text="查看"
                EventType="打开网页"
                EventData="https://music.163.com/#/song?id=1915291185"/>
            <local:MyButton
                Visibility="Visible"
                Margin="1,0,1,0"
                Height="18"
                Width="50"
                ToolTip="呼出本地网易云音乐打开！"
                Text="客户端"
                EventType="打开网页"
                EventData="https://p.kaphia.qzz.io/PCLCloudMusicPageRedirect?id=1915291185&amp;type=song"/>
            <TextBlock Margin="1,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Text="从前说"
                       ToolTip="从前说"/>
        </StackPanel>
    </StackPanel>
    <StackPanel VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="-7,-7,-7,0">
                <Border Height="25"
        Margin="1"
        Background="#e02e66"
        CornerRadius="7"
        HorizontalAlignment="Left"
        ToolTip="此歌曲需要VIP/SVIP">
    <StackPanel HorizontalAlignment="Center"
                Margin="10,3,10,3"
                VerticalAlignment="Center"
                Orientation="Horizontal">
        <TextBlock FontSize="18"
                   Margin="0,0,2,-1"
                   Foreground="{DynamicResource ColorBrush8}"
                   VerticalAlignment="Bottom"
                   Text="VIP"/>
    </StackPanel>
</Border>
    </StackPanel>
</local:MyCard>
