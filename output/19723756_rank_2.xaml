                       FontSize="12"
                       Text="Ela ke Cavucadinha"
                       ToolTip="Ela ke Cavucadinha"/>
        </StackPanel>
    </StackPanel>
    <StackPanel VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="-7,-7,-7,0">
                
